/*
    ArozOS Office Suite - Module Register Script

    Registers three webapps (Docs, Sheets, Slides) that live inside the
    shared src/web/Office/ folder. All three share the resources under
    Office/common/ (framework, chrome CSS, chart renderer, vendored libs
    and the AGI file-saver backend).

    File formats: each app saves straight into the Office format of its
    kind, with the editor's own copy embedded in the package so the suite
    reopens exactly what it saved (mod/office native.go):
        .docx - Docs   (word processor document)
        .xlsx - Sheets (spreadsheet workbook)
        .pptx - Slides (presentation)
    and opens the OpenDocument and text formats besides.
*/

//Docs - word processor
registerModule(JSON.stringify({
    Name: "Docs",
    Desc: "ArozOS Office word processor",
    Group: "Office",
    IconPath: "Office/docs/docs.png",
    Version: "1.0",
    StartDir: "Office/docs/index.html",
    SupportFW: true,
    LaunchFWDir: "Office/docs/index.html",
    SupportEmb: true,
    LaunchEmb: "Office/docs/index.html",
    // the window opens at the size of the start-up splash and grows to
    // 1080x700 once the document is ready (common/splash.js, data-size)
    InitFWSize: [480, 320],
    InitEmbSize: [480, 320],
    SupportedExt: [".docx", ".odt"]
}));

//Sheets - spreadsheet
registerModule(JSON.stringify({
    Name: "Sheets",
    Desc: "ArozOS Office spreadsheet",
    Group: "Office",
    IconPath: "Office/sheets/sheets.png",
    Version: "1.0",
    StartDir: "Office/sheets/index.html",
    SupportFW: true,
    LaunchFWDir: "Office/sheets/index.html",
    SupportEmb: true,
    LaunchEmb: "Office/sheets/index.html",
    // splash-sized, grows to 1180x720 when ready (common/splash.js)
    InitFWSize: [480, 320],
    InitEmbSize: [480, 320],
    SupportedExt: [".xlsx", ".ods", ".csv", ".tsv"]
}));


//Slides - presentation
registerModule(JSON.stringify({
    Name: "Slides",
    Desc: "ArozOS Office presentation editor",
    Group: "Office",
    IconPath: "Office/slides/slides.png",
    Version: "1.0",
    StartDir: "Office/slides/index.html",
    SupportFW: true,
    LaunchFWDir: "Office/slides/index.html",
    SupportEmb: true,
    LaunchEmb: "Office/slides/index.html",
    // splash-sized, grows to 1220x740 when ready (common/splash.js)
    InitFWSize: [480, 320],
    InitEmbSize: [480, 320],
    SupportedExt: [".pptx", ".odp"]
}));


