/*
    Docs - OpenDocument / PDF conversion backend

    Bridges the Docs webapp to the "office" AGI library (mod/office) for the
    formats a document can be converted to and from. Its own format, .docx,
    is opened and saved by common/backend/document.agi.

    POST parameters:
        action = "import-odf" | "export-odf" | "export-pdf"

        import-odf: src  - virtual path of the .odt to read
                    -> {"body": <Docs body schema object>}

        export-odf: dest - virtual path of the .odt to write
                    data - serialized Docs body JSON; pictures may stay
                           media?file= links, the server reads them
                    dataFile - vpath of an uploaded payload file holding that
                           same JSON (deleted after reading)
                    -> "OK"

        export-pdf: dest - virtual path of the .pdf to write
                    data - serialized Docs body JSON (same as export-odf)
                    -> "OK"   (server-side real-text PDF, mod/office)
*/

/*
    The front end uploads a big payload as a file instead of putting it in
    the POST body (OfficeApp.agirunLarge in common/office.js): Go's
    r.ParseForm drops EVERY parameter once a urlencoded body passes 10MB, and
    a compressed upload is much smaller on a slow link anyway. Read it back
    from dataFile when that path was taken, and remove the temp file once it
    is in.
*/
function resolveData(){
    if (typeof dataFile !== "undefined" && dataFile){
        if (!requirelib("filelib")){
            return "";
        }
        // gunzipped by office.readPayload when the browser compressed it
        var content = requirelib("office") ? office.readPayload(dataFile) : filelib.readFile(dataFile);
        filelib.deleteFile(dataFile);
        return content;
    }
    return (typeof data === "undefined" || !data) ? "" : data;
}

function main(){
    if (!requirelib("office")){
        sendJSONResp(JSON.stringify({ error: "office lib unavailable - please update your ArozOS host" }));
        return;
    }

    if (typeof action === "undefined"){
        sendJSONResp(JSON.stringify({ error: "action is required" }));
        return;
    }

    if (action == "import-odf"){
        if (typeof src === "undefined" || !src || src.trim() === ""){
            sendJSONResp(JSON.stringify({ error: "src is required" }));
            return;
        }
        try {
            var odtBody = office.odtToDocument(src);
            if (!odtBody){
                sendJSONResp(JSON.stringify({ error: "unable to parse the odt file" }));
                return;
            }
            sendJSONResp('{"body":' + odtBody + '}');
        } catch (e) {
            sendJSONResp(JSON.stringify({ error: "import failed: " + e.message }));
        }
        return;
    }

    if (action == "export-odf"){
        if (typeof dest === "undefined" || !dest || dest.trim() === ""){
            sendJSONResp(JSON.stringify({ error: "dest is required" }));
            return;
        }
        var payload = resolveData();
        if (!payload){
            sendJSONResp(JSON.stringify({ error: "data is required" }));
            return;
        }
        try {
            if (!office.documentToOdt(payload, dest)){
                sendJSONResp(JSON.stringify({ error: "unable to write the odt file" }));
                return;
            }
            sendResp("OK");
        } catch (e) {
            sendJSONResp(JSON.stringify({ error: "export failed: " + e.message }));
        }
        return;
    }

    if (action == "export-pdf"){
        if (typeof dest === "undefined" || !dest || dest.trim() === ""){
            sendJSONResp(JSON.stringify({ error: "dest is required" }));
            return;
        }
        var payload = resolveData();
        if (!payload){
            sendJSONResp(JSON.stringify({ error: "data is required" }));
            return;
        }
        try {
            if (!office.documentToPdf(payload, dest)){
                sendJSONResp(JSON.stringify({ error: "unable to write the pdf file" }));
                return;
            }
            sendResp("OK");
        } catch (e) {
            sendJSONResp(JSON.stringify({ error: "export failed: " + e.message }));
        }
        return;
    }

    sendJSONResp(JSON.stringify({ error: "unknown action: " + action }));
}

main();
