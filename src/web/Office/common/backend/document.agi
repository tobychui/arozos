/*
    ArozOS Office Suite - document backend

    Opens and saves the suite's documents. Docs, Sheets and Slides live in
    .docx / .xlsx / .pptx files: office.saveDocument writes the OOXML plus
    the editor's own envelope embedded in the package, and office.loadDocument
    hands the envelope back - the embedded copy when nothing else has changed
    the file, an import of the OOXML when Word, Excel or PowerPoint has (see
    mod/office native.go).

    Media handling: documents reference media through media?file= links
    (either the user's own files or uploads under the Office working
    directory). office.saveDocument reads those files server side, so the
    pictures never travel from the browser on a save, and office.loadDocument
    extracts a document's media into a per-document cache dir and links it,
    so they are streamed rather than sent as base64 on an open.

    Working directory: user:/.appdata/Office/
        uploads/   media dropped in from the device (via the system
                   upload endpoint, streamed as multipart)
        tmp/       request payloads the front end uploaded instead of
                   posting (OfficeApp.agirunLarge), gzipped where the
                   browser can compress - consumed and deleted by the
                   backend script that receives them; swept on "prepare"
        cache/     media extracted from opened documents
        session/   rolling per-app snapshots for "Restore from previous
                   session"

    POST parameters:
        action = "save" | "load" | "prepare" | "session-save" |
                 "session-load" | "session-delete"

        save:           filepath (.docx/.xlsx/.pptx), content (envelope JSON) -> "OK"
                        contentFile may replace content: vpath of an uploaded
                        payload file (deleted after reading)
        load:           filepath                             -> {"envelope": {...}}
        prepare:        (none)                               -> "OK" (workdir exists)
        session-save:   app, content(envelope JSON)          -> "OK"
        session-load:   app                                  -> {"envelope": {...}} or {"none": true}
        session-delete: app  (drop the snapshot so it stops  -> "OK"
                              prompting on next launch)
*/

var WORKDIR = "user:/.appdata/Office";

function ensureWorkdir(){
    if (!requirelib("filelib")){
        return false;
    }
    var dirs = [
        "user:/.appdata",
        WORKDIR,
        WORKDIR + "/uploads",
        WORKDIR + "/cache",
        WORKDIR + "/session",
        WORKDIR + "/tmp"
    ];
    for (var i = 0; i < dirs.length; i++){
        if (!filelib.fileExists(dirs[i])){
            filelib.mkdir(dirs[i]);
        }
    }
    return true;
}

/*
    Drop leftover agirunLarge payloads (see OfficeApp.agirunLarge): the
    receiving script deletes its own temp file, so anything still here is
    from a request that was interrupted before the backend ran.
*/
function sweepTmp(){
    var maxAgeMs = 24 * 60 * 60 * 1000;
    var now = new Date().getTime();
    try {
        var leftovers = filelib.glob(WORKDIR + "/tmp/*");
        for (var i = 0; i < leftovers.length; i++){
            var ts = filelib.mtime(leftovers[i], true);
            if (!ts || (now - ts * 1000) > maxAgeMs){
                filelib.deleteFile(leftovers[i]);
            }
        }
    } catch (e) {
        //non-fatal: a failed sweep must never block the workdir setup
    }
}

function safeAppName(name){
    return String(name || "app").replace(/[^a-zA-Z0-9_-]/g, "").substring(0, 32);
}

/*
    The front end uploads a big payload as a file instead of putting it in
    the POST body (OfficeApp.agirunLarge in common/office.js): Go's
    r.ParseForm drops EVERY parameter once a urlencoded body passes 10MB, and
    a compressed upload is much smaller on a slow link anyway. Read it back
    from contentFile when that path was taken (office.readPayload gunzips it),
    and remove the temp file once it is in.
*/
function resolveContent(){
    if (typeof contentFile !== "undefined" && contentFile){
        if (!requirelib("filelib")){
            return "";
        }
        var loaded = requirelib("office") ? office.readPayload(contentFile) : filelib.readFile(contentFile);
        filelib.deleteFile(contentFile);
        return loaded;
    }
    return (typeof content === "undefined" || !content) ? "" : content;
}

function requireFilepath(){
    if (typeof filepath === "undefined" || !filepath || filepath.trim() === ""){
        sendJSONResp(JSON.stringify({ error: "filepath is required" }));
        return false;
    }
    return true;
}

function main(){
    if (typeof action === "undefined"){
        sendJSONResp(JSON.stringify({ error: "action is required" }));
        return;
    }

    if (action == "prepare"){
        if (!ensureWorkdir()){
            sendJSONResp(JSON.stringify({ error: "filelib unavailable" }));
            return;
        }
        sweepTmp();
        sendResp("OK");
        return;
    }

    if (!requirelib("office")){
        sendJSONResp(JSON.stringify({ error: "office lib unavailable - please update your ArozOS host" }));
        return;
    }

    if (action == "save"){
        if (!requireFilepath()){
            return;
        }
        var payload = resolveContent();
        if (!payload){
            sendJSONResp(JSON.stringify({ error: "content is required" }));
            return;
        }
        try {
            if (!office.saveDocument(payload, filepath)){
                sendJSONResp(JSON.stringify({ error: "unable to write the document" }));
                return;
            }
            sendResp("OK");
        } catch (e) {
            sendJSONResp(JSON.stringify({ error: "save failed: " + e.message }));
        }
        return;
    }

    if (action == "load"){
        if (!requireFilepath()){
            return;
        }
        try {
            ensureWorkdir();
            var envelope = office.loadDocument(filepath, WORKDIR + "/cache");
            if (!envelope){
                sendJSONResp(JSON.stringify({ error: "unable to read the document" }));
                return;
            }
            //envelope is already a JSON string - concat instead of re-encoding
            sendJSONResp('{"envelope":' + envelope + '}');
        } catch (e) {
            sendJSONResp(JSON.stringify({ error: "load failed: " + e.message }));
        }
        return;
    }

    if (action == "session-save"){
        var sessPayload = resolveContent();
        if (typeof app === "undefined" || !sessPayload){
            sendJSONResp(JSON.stringify({ error: "app and content are required" }));
            return;
        }
        try {
            ensureWorkdir();
            var dest = WORKDIR + "/session/" + safeAppName(app) + ".osession";
            if (!office.packToFile(sessPayload, dest)){
                sendJSONResp(JSON.stringify({ error: "unable to write the session snapshot" }));
                return;
            }
            sendResp("OK");
        } catch (e) {
            sendJSONResp(JSON.stringify({ error: "session save failed: " + e.message }));
        }
        return;
    }

    if (action == "session-load"){
        if (typeof app === "undefined"){
            sendJSONResp(JSON.stringify({ error: "app is required" }));
            return;
        }
        if (!requirelib("filelib")){
            sendJSONResp(JSON.stringify({ none: true }));
            return;
        }
        try {
            var src = WORKDIR + "/session/" + safeAppName(app) + ".osession";
            if (!filelib.fileExists(src)){
                sendJSONResp(JSON.stringify({ none: true }));
                return;
            }
            ensureWorkdir();
            var sess = office.unpackToWorkdir(src, WORKDIR + "/cache");
            if (!sess){
                sendJSONResp(JSON.stringify({ none: true }));
                return;
            }
            sendJSONResp('{"envelope":' + sess + '}');
        } catch (e) {
            sendJSONResp(JSON.stringify({ none: true, error: e.message }));
        }
        return;
    }

    if (action == "session-delete"){
        if (typeof app === "undefined"){
            sendJSONResp(JSON.stringify({ error: "app is required" }));
            return;
        }
        if (!requirelib("filelib")){
            sendJSONResp(JSON.stringify({ error: "filelib unavailable" }));
            return;
        }
        try {
            var target = WORKDIR + "/session/" + safeAppName(app) + ".osession";
            //deleting a non-existent snapshot is a no-op success
            if (filelib.fileExists(target)){
                filelib.deleteFile(target);
            }
            sendResp("OK");
        } catch (e) {
            sendJSONResp(JSON.stringify({ error: "session delete failed: " + e.message }));
        }
        return;
    }

    sendJSONResp(JSON.stringify({ error: "unknown action: " + action }));
}

main();
